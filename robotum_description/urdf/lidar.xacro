<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="lidar_r" value="0.04"/>
  <xacro:property name="lidar_h" value="0.05"/>
  <xacro:property name="lidar_mass" value="0.1"/>
  <xacro:property name="lidar_x" value="0.1"/>

  <link name="lidar_link">
    <visual>
      <geometry><cylinder radius="${lidar_r}" length="${lidar_h}"/></geometry>
      <material name="yesil"/>
    </visual>
    <collision>
      <geometry><cylinder radius="${lidar_r}" length="${lidar_h}"/></geometry>
    </collision>
    <inertial>
      <mass value="${lidar_mass}"/>
      <inertia ixx="${lidar_mass*(3*lidar_r**2 + lidar_h**2)/12}" ixy="0" ixz="0"
               iyy="${lidar_mass*(3*lidar_r**2 + lidar_h**2)/12}" iyz="0"
               izz="${lidar_mass*lidar_r**2/2}"/>
    </inertial>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="${lidar_x} 0 ${chassis_z/2 + lidar_h/2}"/>
  </joint>

  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <!-- mesajin frame_id'si TF agacindaki link adiyla ayni olmali -->
      <gz_frame_id>lidar_link</gz_frame_id>
      <topic>scan</topic>
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
          <vertical>
            <samples>1</samples>
            <min_angle>0</min_angle>
            <max_angle>0</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.1</min>
          <max>10.0</max>
          <resolution>0.01</resolution>
        </range>
      </lidar>
    </sensor>
  </gazebo>

</robot>
