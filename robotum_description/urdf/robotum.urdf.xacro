<?xml version="1.0"?>
<robot name="robotum" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ===== BOYUTLAR: tasarimi buradan degistir ===== -->
  <xacro:property name="chassis_x" value="0.4"/>
  <xacro:property name="chassis_y" value="0.3"/>
  <xacro:property name="chassis_z" value="0.1"/>
  <xacro:property name="chassis_mass" value="5.0"/>
  <xacro:property name="chassis_height" value="0.1"/>  <!-- govde merkezinin yerden yuksekligi -->

  <xacro:property name="wheel_r" value="0.08"/>
  <xacro:property name="wheel_w" value="0.04"/>
  <xacro:property name="wheel_mass" value="0.5"/>
  <xacro:property name="wheel_x" value="-0.1"/>
  <xacro:property name="wheel_gap" value="0.005"/>
  <xacro:property name="wheel_y" value="${chassis_y/2 + wheel_w/2 + wheel_gap}"/>

  <xacro:property name="caster_r" value="0.03"/>
  <xacro:property name="caster_x" value="0.15"/>

  <!-- ===== RENKLER (RViz icin) ===== -->
  <material name="mavi"><color rgba="0.2 0.2 0.8 1"/></material>
  <material name="siyah"><color rgba="0.1 0.1 0.1 1"/></material>
  <material name="yesil"><color rgba="0.1 0.8 0.1 1"/></material>

  <!-- ===== GOVDE ===== -->
  <link name="base_link">
    <visual>
      <geometry><box size="${chassis_x} ${chassis_y} ${chassis_z}"/></geometry>
      <material name="mavi"/>
    </visual>
    <collision>
      <geometry><box size="${chassis_x} ${chassis_y} ${chassis_z}"/></geometry>
    </collision>

    <!-- caster: govdenin ikinci collision'i -->
    <visual>
      <origin xyz="${caster_x} 0 ${caster_r - chassis_height}"/>
      <geometry><sphere radius="${caster_r}"/></geometry>
      <material name="siyah"/>
    </visual>
    <collision>
      <origin xyz="${caster_x} 0 ${caster_r - chassis_height}"/>
      <geometry><sphere radius="${caster_r}"/></geometry>
    </collision>

    <inertial>
      <mass value="${chassis_mass}"/>
      <inertia ixx="${chassis_mass*(chassis_y**2 + chassis_z**2)/12}" ixy="0" ixz="0"
               iyy="${chassis_mass*(chassis_x**2 + chassis_z**2)/12}" iyz="0"
               izz="${chassis_mass*(chassis_x**2 + chassis_y**2)/12}"/>
    </inertial>
  </link>

  <!-- ===== TEKERLEK MAKROSU ===== -->
  <xacro:macro name="wheel" params="prefix y_sign">
    <link name="${prefix}_wheel">
      <visual>
        <origin rpy="${-pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_r}" length="${wheel_w}"/></geometry>
        <material name="siyah"/>
      </visual>
      <collision>
        <origin rpy="${-pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_r}" length="${wheel_w}"/></geometry>
      </collision>
      <!-- eksen y yonunde oldugu icin Iyy = m r^2 / 2 -->
      <inertial>
        <mass value="${wheel_mass}"/>
        <inertia ixx="${wheel_mass*(3*wheel_r**2 + wheel_w**2)/12}" ixy="0" ixz="0"
                 iyy="${wheel_mass*wheel_r**2/2}" iyz="0"
                 izz="${wheel_mass*(3*wheel_r**2 + wheel_w**2)/12}"/>
      </inertial>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel"/>
      <origin xyz="${wheel_x} ${y_sign*wheel_y} ${wheel_r - chassis_height}"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:wheel prefix="left"  y_sign="1"/>
  <xacro:wheel prefix="right" y_sign="-1"/>

  <!-- ===== EK DOSYALAR ===== -->
  <xacro:include filename="gazebo.xacro"/>   <!-- surus plugini, joint state, surtunme -->
  <xacro:include filename="lidar.xacro"/>    <!-- LiDAR: link + joint + sensor -->
  <!-- arkadasin kamerayi buraya ekleyecek: <xacro:include filename="camera.xacro"/> -->

</robot>
